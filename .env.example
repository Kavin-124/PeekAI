# Google Gemini API Key (Get yours free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Default Model (gemini-3.5-flash-lite is recommended for ultra-fast multimodal response)
PEEK_MODEL=gemini-3.5-flash-lite

# Appearance Theme: light (default) or dark
PEEK_THEME=light

# Hotkeys (Global shortcuts):
# Full Screen Peek: Ctrl + Shift + Space
# Region / Snippet Peek: Ctrl + Shift + X
# Append Scrolled Screen: Ctrl + Shift + A
# Stealth Copy Answer: Ctrl + Alt + C
# Open Settings: Ctrl + Shift + S
HOTKEY_FULL_SCREEN=<ctrl>+<shift>+<space>
HOTKEY_SNIPPET=<ctrl>+<shift>+x
HOTKEY_APPEND=<ctrl>+<shift>+a
HOTKEY_STEALTH_COPY=<ctrl>+<alt>+c
HOTKEY_SETTINGS=<ctrl>+<shift>+s
